@inject NavigationManager Nav
@inject AppState State

<div class="row-card" @onclick="GoToDetail">
    <div class="row-thumb" style="background-image:url('@TmdbImage.Poster(Title.PosterPath, "w154")')"></div>
    <div class="row-meta">
        <strong>@Title.Title</strong>
        <div class="sub">
            @(Title.ReleaseDate is { } d ? DateFormatting.FullDateOrYear(d) : "Fecha por confirmar")
            ·
            <span style="color:@(Title.Type == TitleType.Series ? "var(--accent2)" : "var(--gold)")">
                @(Title.Type == TitleType.Series ? "Serie" : "Película")
            </span>
        </div>
    </div>
    <div class="row-right">@(ShowRating && Title.VoteAverage > 0 ? $"★ {Title.VoteAverage:0.0}" : RelativeLabel())</div>
</div>

@code {
    [Parameter, EditorRequired] public TitleSummaryDto Title { get; set; } = null!;
    [Parameter] public bool ShowRating { get; set; }

    private void GoToDetail() => DetailNavigation.GoToDetail(Nav, State, Title.Key);

    private string RelativeLabel() => Title.ReleaseDate switch
    {
        { } d when ReleaseDatePrecision.IsYearOnly(d) => "",
        { } d => DateFormatting.RelativeDays(d),
        null => "",
    };
}
