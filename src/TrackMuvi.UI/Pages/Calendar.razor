@page "/calendar"
@inject ITrackMuviApiClient Api
@inject IPersonalListService PersonalList
@inject AppState State

<header class="app-bar">
    <div class="app-title">Calendario</div>
    <div style="display:flex; align-items:center; gap:14px;">
        <button class="icon-btn" @onclick="JumpToToday" title="Ir a hoy">
            <span class="material-symbols-outlined">today</span>
        </button>
        <NotifBell />
    </div>
</header>

@if (_loading)
{
    <div class="loading-spinner">Cargando estrenos...</div>
}
else if (_error is not null)
{
    <div class="error-box">@_error</div>
}
else
{
    <div class="filters-scroll">
        <div class="chip @(State.CalendarFilter == "all" ? "active" : "")" @onclick='() => OnFilterChanged("all")'>Todos</div>
        <div class="chip @(State.CalendarFilter == "series" ? "active" : "")" @onclick='() => OnFilterChanged("series")'>Series</div>
        <div class="chip @(State.CalendarFilter == "movie" ? "active" : "")" @onclick='() => OnFilterChanged("movie")'>Películas</div>
        <div class="chip @(State.CalendarFilter == "platforms" ? "active" : "")" @onclick='() => OnFilterChanged("platforms")'>Plataformas</div>
    </div>

    <div class="calendar-card">
        <div class="month-selector">
            <button class="month-nav" @onclick="PrevMonth"><span class="material-symbols-outlined">chevron_left</span></button>
            <h2>@DateFormatting.MonthYearLabel(_currentMonth)</h2>
            <button class="month-nav" @onclick="NextMonth"><span class="material-symbols-outlined">chevron_right</span></button>
        </div>

        @if (_monthLoading)
        {
            <div class="loading-spinner">Cargando @DateFormatting.MonthYearLabel(_currentMonth)...</div>
        }
        else
        {
            <div class="calendar-grid">
                @foreach (var wd in WeekdayLabels)
                {
                    <div class="weekday">@wd</div>
                }
                @foreach (var cell in BuildGridCells())
                {
                    <div class="day-cell @(cell.Muted ? "muted" : "") @(cell.Date == Today ? "today" : "") @(cell.Date == _selectedDate ? "selected" : "")"
                         @onclick="() => SelectDate(cell.Date)">
                        @cell.Date.Day
                        @if (cell.HasSeries || cell.HasMovie)
                        {
                            <div class="event-dots">
                                @if (cell.HasSeries) { <div class="dot series"></div> }
                                @if (cell.HasMovie) { <div class="dot movie"></div> }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="agenda-header">
        <h3>@DateFormatting.DayNameAndNumber(_selectedDate)</h3>
        <span>@_agendaItems.Count estreno@(_agendaItems.Count == 1 ? "" : "s")</span>
    </div>

    <div class="schedule-list">
        @if (_agendaLoading)
        {
            <div class="loading-spinner">Cargando...</div>
        }
        else if (_agendaItems.Count == 0)
        {
            <div class="empty">Nada programado este día.</div>
        }
        else
        {
            @foreach (var item in _agendaItems)
            {
                <ScheduleItem Key="@item.Key" Type="@item.Type" Title="@item.Title" Subtitle="@item.Subtitle"
                              TimeLabel="@item.TimeLabel" TimeIcon="@item.TimeIcon" PosterPath="@item.PosterPath"
                              NotificationsOn="@item.NotificationsOn" />
            }
        }
    </div>
}

@code {
    private static readonly string[] WeekdayLabels = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private bool _loading = true;
    private bool _monthLoading = true;
    private bool _agendaLoading = true;
    private string? _error;

    private List<CalendarEvent> _movieEvents = [];
    private List<CalendarEvent> _episodeEvents = [];
    private List<string> _followingKeys = [];
    private List<string> _wantKeys = [];

    private DateOnly _currentMonth;
    private DateOnly _selectedDate;
    private List<AgendaCard> _agendaItems = [];

    protected override async Task OnInitializedAsync()
    {
        _selectedDate = Today;
        _currentMonth = new DateOnly(Today.Year, Today.Month, 1);

        try
        {
            _followingKeys = (await PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Following)).ToList();
            _wantKeys = (await PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Want)).ToList();

            var episodes = await Api.GetNextEpisodesAsync(_followingKeys);
            _episodeEvents = episodes.Select(e => new CalendarEvent(
                e.SeriesKey, TitleType.Series, e.AirDate, e.SeriesTitle, e.SeriesPosterPath,
                e.SeasonNumber, e.EpisodeNumber, e.EpisodeName)).ToList();

            await LoadMoviesForCurrentMonthAsync();
            await LoadAgendaAsync(_selectedDate);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el calendario: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Pide a la API solo los estrenos de cine del mes que se está mostrando (TMDb /discover/movie
    /// soporta rango de fechas real, a diferencia del viejo /movie/upcoming que daba una ventana
    /// fija de corto plazo). Se vuelve a llamar cada vez que cambia el mes visible.
    /// </summary>
    private async Task LoadMoviesForCurrentMonthAsync()
    {
        _monthLoading = true;
        StateHasChanged();

        var from = _currentMonth;
        var to = _currentMonth.AddMonths(1).AddDays(-1);

        var page1 = await Api.GetUpcomingMoviesAsync(from, to, page: 1);
        var page2 = await Api.GetUpcomingMoviesAsync(from, to, page: 2);

        _movieEvents = page1.Concat(page2)
            .Where(m => m.ReleaseDate is not null)
            .DistinctBy(m => m.Key)
            .Select(m => new CalendarEvent(m.Key, TitleType.Movie, m.ReleaseDate!.Value, m.Title, m.PosterPath, null, null, null))
            .ToList();

        _monthLoading = false;
    }

    private IEnumerable<CalendarEvent> AllEvents() => _movieEvents.Concat(_episodeEvents);

    private IEnumerable<CalendarEvent> FilteredEvents() => State.CalendarFilter switch
    {
        "series" => AllEvents().Where(e => e.Type == TitleType.Series),
        "movie" => AllEvents().Where(e => e.Type == TitleType.Movie),
        _ => AllEvents() // "all" y "platforms" (sin filtro propio todavía) muestran todo
    };

    private List<DayCellVm> BuildGridCells()
    {
        var eventsByDate = FilteredEvents().GroupBy(e => e.Date).ToDictionary(g => g.Key, g => g.ToList());

        var offset = ((int)_currentMonth.DayOfWeek + 6) % 7; // Lunes=0 ... Domingo=6
        var daysInMonth = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
        var totalCells = (int)Math.Ceiling((offset + daysInMonth) / 7.0) * 7;

        var cells = new List<DayCellVm>(totalCells);
        for (var i = 0; i < totalCells; i++)
        {
            var date = _currentMonth.AddDays(i - offset);
            var muted = date.Month != _currentMonth.Month;
            var hasEvents = eventsByDate.TryGetValue(date, out var evs);
            cells.Add(new DayCellVm(
                date, muted,
                hasEvents && evs!.Any(e => e.Type == TitleType.Series),
                hasEvents && evs!.Any(e => e.Type == TitleType.Movie)));
        }

        return cells;
    }

    private async Task SelectDate(DateOnly date)
    {
        var monthChanged = date.Month != _currentMonth.Month || date.Year != _currentMonth.Year;
        _selectedDate = date;

        if (monthChanged)
        {
            _currentMonth = new DateOnly(date.Year, date.Month, 1);
            await LoadMoviesForCurrentMonthAsync();
        }

        await LoadAgendaAsync(date);
    }

    private async Task PrevMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        await LoadMoviesForCurrentMonthAsync();
    }

    private async Task NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        await LoadMoviesForCurrentMonthAsync();
    }

    private Task JumpToToday() => SelectDate(Today);

    private async Task OnFilterChanged(string filter)
    {
        State.CalendarFilter = filter;
        await LoadAgendaAsync(_selectedDate);
    }

    private async Task LoadAgendaAsync(DateOnly date)
    {
        _agendaLoading = true;
        StateHasChanged();

        var dayEvents = FilteredEvents().Where(e => e.Date == date).ToList();
        var cards = new List<AgendaCard>();

        foreach (var ev in dayEvents)
        {
            var detail = await Api.GetTitleDetailAsync(ev.Key);

            if (ev.Type == TitleType.Movie)
            {
                var genre = detail?.Genres.FirstOrDefault()?.Name;
                var subtitle = genre is not null && detail?.DurationMinutes is { } duration
                    ? $"{genre} • {duration} min"
                    : "Estreno de cine";
                cards.Add(new AgendaCard(ev.Key, TitleType.Movie, ev.Title, subtitle, "Cine", "theaters",
                    ev.PosterPath, _wantKeys.Contains(ev.Key)));
            }
            else
            {
                var episodeLabel = $"S{ev.SeasonNumber:00}E{ev.EpisodeNumber:00}";
                var subtitle = detail?.PrimaryPlatformLabel is { } platform
                    ? $"{episodeLabel} • \"{ev.EpisodeName}\" ({platform})"
                    : $"{episodeLabel} • \"{ev.EpisodeName}\"";
                cards.Add(new AgendaCard(ev.Key, TitleType.Series, ev.Title, subtitle,
                    DateFormatting.RelativeDays(date), "schedule", ev.PosterPath, _followingKeys.Contains(ev.Key)));
            }
        }

        _agendaItems = cards;
        _agendaLoading = false;
    }

    private record CalendarEvent(
        string Key, TitleType Type, DateOnly Date, string Title, string? PosterPath,
        int? SeasonNumber, int? EpisodeNumber, string? EpisodeName);

    private record DayCellVm(DateOnly Date, bool Muted, bool HasSeries, bool HasMovie);

    private record AgendaCard(
        string Key, TitleType Type, string Title, string Subtitle,
        string TimeLabel, string TimeIcon, string? PosterPath, bool NotificationsOn);
}
