@page "/"
@inject ITrackMuviApiClient Api
@inject IPersonalListService PersonalList
@inject IReleaseCheckService ReleaseCheck
@inject NavigationManager Nav
@inject AppState State

<PageHeader Title="Inicio" />

@if (_loading)
{
    <div class="loading-spinner">Cargando catálogo...</div>
}
else if (_error is not null)
{
    <div class="error-box">@_error</div>
}
else
{
    @if (_todayReleases.Count > 0)
    {
        <section class="section-container" style="margin-top:20px;">
            <div class="section-header"><h2 class="section-title">Hoy</h2></div>
            <div class="row-list">
                @foreach (var item in _todayReleases)
                {
                    <div class="row-card" @onclick="() => GoToDetail(item.Key)">
                        <div class="row-thumb" style="background-image:url('@TmdbImage.Poster(item.PosterPath, "w154")')"></div>
                        <div class="row-meta">
                            <strong>@item.Title</strong>
                            <div class="sub">@TodaySubtitle(item)</div>
                        </div>
                        <div class="row-right" style="color:var(--gold);">HOY</div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section-container" style="margin-top:20px;">
        <div class="section-header"><h2 class="section-title">Tendencias del mes</h2></div>
        <div class="trending-scroll">
            @{ var rank = 1; }
            @foreach (var item in _trending)
            {
                <TrendingCard Title="@item" Rank="@rank" />
                rank++;
            }
        </div>
    </section>

    <section class="section-container">
        <div class="section-header">
            <h2 class="section-title">Series que sigues</h2>
            @if (_followingTotalCount > 0)
            {
                <a style="color:var(--accent); font-size:13px; font-weight:600; cursor:pointer;" @onclick="GoToFollowing">Ver más</a>
            }
        </div>
        @if (_following.Count > 0)
        {
            <div class="row-list">
                @foreach (var item in _following.Take(FollowingPreviewCount))
                {
                    <RowCard Title="@item" />
                }
            </div>
        }
        else if (_followingTotalCount > 0)
        {
            <div class="empty">Ninguna de las series que sigues está en emisión ahora mismo.</div>
        }
        else
        {
            <div class="empty">Aún no sigues ninguna serie. Ve a Descubrir y pulsa "Seguir" en una ficha.</div>
        }
    </section>

    @if (_discoverMore.Count > 0)
    {
        <section class="section-container" style="margin-bottom:50px;">
            <div class="section-header"><h2 class="section-title">Descubre algo nuevo</h2></div>
            <div class="poster-scroll">
                @foreach (var item in _discoverMore)
                {
                    <PosterCard Title="@item" />
                }
            </div>
        </section>
    }
}

@code {
    private const int FollowingPreviewCount = 5;
    private const int DiscoverMoreCount = 12;
    // Cuántos títulos favoritos/vistos como máximo se mandan como base a /recommendations:
    // cada uno es una llamada aparte a TMDb del lado del servidor.
    private const int RecommendationBasisCount = 6;

    private bool _loading = true;
    private string? _error;
    private List<TitleSummaryDto> _trending = [];
    private List<TitleSummaryDto> _discoverMore = [];
    private List<TitleSummaryDto> _following = [];
    private int _followingTotalCount;
    private List<TodayReleaseDto> _todayReleases = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Todo lo que no depende de otra llamada arranca junto en vez de encadenarse en serie
            // (antes: trending -> following -> today-releases, uno atrás del otro).
            var moviesTask = Api.GetTrendingMoviesAsync();
            var tvTask = Api.GetTrendingTvAsync();
            var followingKeysTask = PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Following);
            var favoriteKeysTask = PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Favorite);
            var watchedKeysTask = PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Watched);
            var wantKeysTask = PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Want);
            var todayReleasesTask = LoadTodayReleasesAsync();

            await Task.WhenAll(moviesTask, tvTask, followingKeysTask, favoriteKeysTask, watchedKeysTask, wantKeysTask, todayReleasesTask);

            var combined = moviesTask.Result.Concat(tvTask.Result).OrderByDescending(t => t.Popularity).ToList();
            _trending = combined.Take(4).ToList();

            // Base para "porque viste/marcaste X": favoritas primero, después vistas (ambas ya vienen
            // de más reciente a más vieja), sin repetir.
            var basis = favoriteKeysTask.Result.Concat(watchedKeysTask.Result)
                .Distinct().Take(RecommendationBasisCount).ToList();
            var alreadyKnown = favoriteKeysTask.Result.Concat(watchedKeysTask.Result)
                .Concat(wantKeysTask.Result).Concat(followingKeysTask.Result).ToHashSet();

            _discoverMore = basis.Count > 0
                ? (await Api.GetRecommendationsAsync(basis))
                    .Where(t => !alreadyKnown.Contains(t.Key))
                    .Take(DiscoverMoreCount)
                    .ToList()
                // Todavía no hay suficiente historial para recomendar algo personalizado: se
                // mantiene el comportamiento anterior (sobras de tendencias) en vez de dejarlo vacío.
                : combined.Skip(4).Take(DiscoverMoreCount).ToList();

            // Esto sí depende de followingKeysTask, así que recién arranca cuando ese ya resolvió.
            var details = await Task.WhenAll(followingKeysTask.Result.Select(k => Api.GetTitleDetailAsync(k, full: false)));
            var followingDetails = details.Where(d => d is not null).Select(d => d!).ToList();

            _followingTotalCount = followingDetails.Count;
            // Solo las que TMDb marca como "en emisión" (no terminadas/canceladas); ver todo lo
            // que se sigue, en emisión o no, está a un toque en "Ver más" (Mi Lista > Siguiendo).
            _following = followingDetails
                .Where(d => d.Status == "Returning Series")
                .Select(d => d.ToSummary())
                .ToList();

            _todayReleases = todayReleasesTask.Result.ToList();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el catálogo: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Red de seguridad si la notificación push no llegó a tiempo (ver ReleaseCheckService).
    /// Nunca lanza: sin red, Inicio sigue siendo usable, solo no se muestra el aviso "Hoy".</summary>
    private async Task<IReadOnlyList<TodayReleaseDto>> LoadTodayReleasesAsync()
    {
        try
        {
            return await ReleaseCheck.GetTodayReleasesAsync();
        }
        catch
        {
            return [];
        }
    }

    private static string TodaySubtitle(TodayReleaseDto item) => item.Type == TitleType.Series
        ? $"S{item.SeasonNumber:00}E{item.EpisodeNumber:00}" +
          (item.EpisodeName is not null ? $" · \"{item.EpisodeName}\"" : "") + " sale hoy"
        : "Se estrena hoy";

    private void GoToDetail(string key) => DetailNavigation.GoToDetail(Nav, State, key);

    private void GoToFollowing()
    {
        State.ListTab = "following";
        Nav.NavigateTo("/mylist");
    }
}
