@page "/"
@inject ITrackMuviApiClient Api
@inject IPersonalListService PersonalList
@inject IReleaseCheckService ReleaseCheck
@inject NavigationManager Nav
@inject AppState State

<PageHeader Title="Inicio" />

@if (_loading)
{
    <div class="loading-spinner">Cargando catálogo...</div>
}
else if (_error is not null)
{
    <div class="error-box">@_error</div>
}
else
{
    @if (_todayReleases.Count > 0)
    {
        <section class="section-container" style="margin-top:20px;">
            <div class="section-header"><h2 class="section-title">Hoy</h2></div>
            <div class="row-list">
                @foreach (var item in _todayReleases)
                {
                    <div class="row-card" @onclick="() => GoToDetail(item.Key)">
                        <div class="row-thumb" style="background-image:url('@TmdbImage.Poster(item.PosterPath, "w154")')"></div>
                        <div class="row-meta">
                            <strong>@item.Title</strong>
                            <div class="sub">@TodaySubtitle(item)</div>
                        </div>
                        <div class="row-right" style="color:var(--gold);">HOY</div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section-container" style="margin-top:20px;">
        <div class="section-header"><h2 class="section-title">Tendencias de la semana</h2></div>
        <div class="trending-scroll">
            @{ var rank = 1; }
            @foreach (var item in _trending)
            {
                <TrendingCard Title="@item" Rank="@rank" />
                rank++;
            }
        </div>
    </section>

    <section class="section-container">
        <div class="section-header">
            <h2 class="section-title">Series que sigues</h2>
            @if (_followingTotalCount > 0)
            {
                <a style="color:var(--accent); font-size:13px; font-weight:600; cursor:pointer;" @onclick="GoToFollowing">Ver más</a>
            }
        </div>
        @if (_following.Count > 0)
        {
            <div class="row-list">
                @foreach (var item in _following.Take(FollowingPreviewCount))
                {
                    <RowCard Title="@item" />
                }
            </div>
        }
        else if (_followingTotalCount > 0)
        {
            <div class="empty">Ninguna de las series que sigues está en emisión ahora mismo.</div>
        }
        else
        {
            <div class="empty">Aún no sigues ninguna serie. Ve a Descubrir y pulsa "Seguir" en una ficha.</div>
        }
    </section>

    <section class="section-container" style="margin-bottom:50px;">
        <div class="section-header"><h2 class="section-title">Descubre algo nuevo</h2></div>
        <div class="poster-scroll">
            @foreach (var item in _discoverMore)
            {
                <PosterCard Title="@item" />
            }
        </div>
    </section>
}

@code {
    private const int FollowingPreviewCount = 5;

    private bool _loading = true;
    private string? _error;
    private List<TitleSummaryDto> _trending = [];
    private List<TitleSummaryDto> _discoverMore = [];
    private List<TitleSummaryDto> _following = [];
    private int _followingTotalCount;
    private List<TodayReleaseDto> _todayReleases = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var movies = await Api.GetTrendingMoviesAsync();
            var tv = await Api.GetTrendingTvAsync();
            var combined = movies.Concat(tv).OrderByDescending(t => t.Popularity).ToList();

            _trending = combined.Take(4).ToList();
            _discoverMore = combined.Skip(4).Take(12).ToList();

            var followingKeys = await PersonalList.GetKeysByFlagAsync(PersonalStatusFlag.Following);
            var details = await Task.WhenAll(followingKeys.Select(k => Api.GetTitleDetailAsync(k)));
            var followingDetails = details.Where(d => d is not null).Select(d => d!).ToList();

            _followingTotalCount = followingDetails.Count;
            // Solo las que TMDb marca como "en emisión" (no terminadas/canceladas); ver todo lo
            // que se sigue, en emisión o no, está a un toque en "Ver más" (Mi Lista > Siguiendo).
            _following = followingDetails
                .Where(d => d.Status == "Returning Series")
                .Select(d => d.ToSummary())
                .ToList();

            // Red de seguridad si la notificación push no llegó a tiempo (ver ReleaseCheckService).
            try
            {
                _todayReleases = (await ReleaseCheck.GetTodayReleasesAsync()).ToList();
            }
            catch
            {
                // sin red/API: la app sigue siendo usable sin el aviso "Hoy".
            }
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el catálogo: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string TodaySubtitle(TodayReleaseDto item) => item.Type == TitleType.Series
        ? $"S{item.SeasonNumber:00}E{item.EpisodeNumber:00}" +
          (item.EpisodeName is not null ? $" · \"{item.EpisodeName}\"" : "") + " sale hoy"
        : "Se estrena hoy";

    private void GoToDetail(string key) => DetailNavigation.GoToDetail(Nav, State, key);

    private void GoToFollowing()
    {
        State.ListTab = "following";
        Nav.NavigateTo("/mylist");
    }
}
