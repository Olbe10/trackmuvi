@page "/coming-soon"
@inject ITrackMuviApiClient Api
@inject NavigationManager Nav

<header class="app-bar">
    <div style="display:flex; align-items:center; gap:12px;">
        <button class="icon-btn" @onclick="GoBack"><span class="material-symbols-outlined">arrow_back</span></button>
        <div class="app-title">Muy pronto</div>
    </div>
</header>

@if (_loading)
{
    <div class="loading-spinner">Cargando...</div>
}
else if (_error is not null)
{
    <div class="error-box">@_error</div>
}
else if (_items.Count == 0)
{
    <div class="empty">No hay películas confirmadas sin fecha exacta por ahora.</div>
}
else
{
    <div class="row-list" style="margin-bottom:30px;">
        @foreach (var item in _items)
        {
            <RowCard Title="@item" />
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<TitleSummaryDto> _items = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = (await Api.GetComingSoonMoviesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/discover");
}
