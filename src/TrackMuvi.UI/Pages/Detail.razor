@page "/title/{Key}"
@inject ITrackMuviApiClient Api
@inject IPersonalListService PersonalList
@inject IEpisodeTrackingService EpisodeTracking
@inject NavigationManager Nav
@inject AppState State

@if (_loading)
{
    <div class="loading-spinner">Cargando ficha...</div>
}
else if (_error is not null)
{
    <div class="error-box">@_error</div>
}
else if (_title is not null)
{
    <div class="detail-hero" style="background-image:url('@TmdbImage.Backdrop(_title.BackdropPath ?? _title.PosterPath)')">
        <button class="back-btn" @onclick="GoBack"><span class="material-symbols-outlined">arrow_back</span></button>
    </div>
    <div class="detail-body">
        <div>
            <span class="tag" style="background:@UniverseColor(_title.Universe); color:#0f1014;">@(_title.Universe ?? "—")</span>
            <span class="tag" style="background:var(--bg-card); color:#fff;">@string.Join(" · ", _title.Genres.Select(g => g.Name))</span>
        </div>
        <h1>@_title.Title</h1>
        <div class="meta-line">
            @(_title.ReleaseDate is { } d ? DateFormatting.FullDate(d) : "Fecha por confirmar")
            · @(_title.PrimaryPlatformLabel ?? "Sin proveedor")
            @(IsSeries ? $" · {_title.Seasons} temporadas" : $" · {_title.DurationMinutes} min · {_title.Rating}")
        </div>

        <div class="status-row">
            @if (IsSeries)
            {
                <StatusButton Label="Seguir" On="@_status.Following" OnClick="() => Toggle(PersonalStatusFlag.Following)" />
                <StatusButton Label="Favorita" On="@_status.Favorite" OnClick="() => Toggle(PersonalStatusFlag.Favorite)" />
            }
            else
            {
                <StatusButton Label="Quiero ver" On="@_status.Want" OnClick="() => Toggle(PersonalStatusFlag.Want)" />
                <StatusButton Label="Vista" On="@_status.Watched" OnClick="() => Toggle(PersonalStatusFlag.Watched)" />
                <StatusButton Label="Favorita" On="@_status.Favorite" OnClick="() => Toggle(PersonalStatusFlag.Favorite)" />
            }
        </div>

        @if (!string.IsNullOrEmpty(_title.TrailerYoutubeKey))
        {
            <a class="trailer-btn" href="@($"https://www.youtube.com/watch?v={_title.TrailerYoutubeKey}")" target="_blank">
                <span class="material-symbols-outlined">play_arrow</span>Ver tráiler
            </a>
        }

        @if (IsSeries && _title.Seasons is { } seasonCount && seasonCount > 0)
        {
            <div class="block">
                <h3>Episodios</h3>
                <div class="season-selector">
                    <span>Temporada @_selectedSeason</span>
                    <span class="material-symbols-outlined">expand_more</span>
                    <select @bind="_selectedSeason" @bind:after="LoadSeasonAsync">
                        @for (var s = 1; s <= seasonCount; s++)
                        {
                            <option value="@s">Temporada @s</option>
                        }
                    </select>
                </div>

                @if (_seasonLoading)
                {
                    <div class="loading-spinner">Cargando episodios...</div>
                }
                else if (_season is null)
                {
                    <div class="empty">No se pudo cargar esta temporada.</div>
                }
                else
                {
                    <div class="progress-container">
                        <div class="progress-text">
                            <span>Progreso: @_season.WatchedCount de @_season.AiredCount episodios emitidos</span>
                            <span>@ProgressPercent()%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:@(ProgressPercent())%"></div>
                        </div>
                        @if (_season.AiredCount > 0)
                        {
                            <button class="season-watch-btn @(AllAiredWatched ? "all-watched" : "")" @onclick="ToggleSeasonWatched">
                                <span class="material-symbols-outlined" style="font-size:16px;">@(AllAiredWatched ? "remove_done" : "done_all")</span>
                                @(AllAiredWatched ? "Desmarcar temporada" : "Marcar temporada como vista")
                            </button>
                        }
                    </div>

                    <div class="episode-list">
                        @foreach (var ep in _season.Episodes)
                        {
                            <EpisodeCard Episode="@ep" OnToggle="() => ToggleEpisode(ep.EpisodeNumber)" />
                        }
                    </div>
                }
            </div>
        }

        <div class="block"><h3>Sinopsis</h3><p>@_title.Synopsis</p></div>
        <div class="block"><h3>@(IsSeries ? "Creador" : "Director")</h3><p>@(_title.Creators.Count > 0 ? string.Join(", ", _title.Creators) : "—")</p></div>

        <div class="block">
            <h3>Reparto</h3>
            <div class="cast-scroll">
                @foreach (var c in _title.Cast)
                {
                    <div class="cast-item">
                        <div class="cast-avatar" style="@(c.ProfilePath is not null ? $"background-image:url('{TmdbImage.Profile(c.ProfilePath)}')" : "")">
                            @(c.ProfilePath is null ? "🎭" : "")
                        </div>
                        <span>@c.Name</span>
                    </div>
                }
            </div>
        </div>

        @if (_title.GalleryBackdropPaths.Count > 0)
        {
            <div class="block" style="margin-bottom:40px;">
                <h3>Galería</h3>
                <div class="gallery">
                    @foreach (var path in _title.GalleryBackdropPaths)
                    {
                        <div style="background-image:url('@TmdbImage.Backdrop(path, "w300")')"></div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private TitleDetailDto? _title;
    private PersonalStatusDto _status = PersonalStatusDto.Empty("");

    private int _selectedSeason = 1;
    private bool _seasonLoading;
    private SeasonProgressDto? _season;

    private bool IsSeries => _title?.Type == TitleType.Series;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _season = null;
        try
        {
            _title = await Api.GetTitleDetailAsync(Key);
            _status = await PersonalList.GetStatusAsync(Key);
            if (_title is null)
            {
                _error = "No se encontró este título.";
            }
            else if (_title.Type == TitleType.Series && _title.Seasons is { } seasonCount && seasonCount > 0)
            {
                _selectedSeason = seasonCount; // por defecto, la temporada más reciente
                await LoadSeasonAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar la ficha: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSeasonAsync()
    {
        _seasonLoading = true;
        StateHasChanged();
        _season = await EpisodeTracking.GetSeasonAsync(Key, _selectedSeason);
        _seasonLoading = false;
    }

    private async Task ToggleEpisode(int episodeNumber)
    {
        await EpisodeTracking.ToggleEpisodeWatchedAsync(Key, _selectedSeason, episodeNumber);
        await LoadSeasonAsync();
    }

    private bool AllAiredWatched => _season is { AiredCount: > 0 } s && s.WatchedCount == s.AiredCount;

    private async Task ToggleSeasonWatched()
    {
        _seasonLoading = true;
        StateHasChanged();
        _season = await EpisodeTracking.SetSeasonWatchedAsync(Key, _selectedSeason, !AllAiredWatched);
        _seasonLoading = false;
    }

    private int ProgressPercent() =>
        _season is null || _season.AiredCount == 0 ? 0 : (int)Math.Round(100.0 * _season.WatchedCount / _season.AiredCount);

    private async Task Toggle(PersonalStatusFlag flag) => _status = await PersonalList.ToggleFlagAsync(Key, flag);

    private void GoBack() => DetailNavigation.GoBack(Nav, State);

    private static string UniverseColor(string? universe) => universe switch
    {
        "Marvel" => "var(--marvel)",
        "DC" => "var(--dc)",
        _ => "var(--indie)"
    };
}
